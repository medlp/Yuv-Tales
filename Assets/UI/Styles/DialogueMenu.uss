.dialogue-container {
    flex-grow: 1;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 50px;
}

.dialogue-box {
    background-color: rgba(0, 0, 0, 0.8);
    border-radius: 10px;
    padding: 20px;
    width: 60%;
    min-width: 400px;
    min-height: 150px;
    flex-shrink: 0;
    align-items: stretch;
    justify-content: flex-start;
}

.dialogue-actor-name {
    color: rgb(255, 200, 0);
    font-size: 24px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    flex-shrink: 0;
}

.dialogue-message-text {
    color: white;
    font-size: 18px;
    white-space: normal;
    flex-grow: 1;
    margin-bottom: 20px;
}

.dialogue-choices-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    flex-shrink: 0;
}

.dialogue-choice-button {
    background-color: rgba(50, 50, 50, 0.8);
    color: white;
    border-width: 1px;
    border-color: rgb(255, 200, 0);
    border-radius: 5px;
    padding: 10px 20px;
    margin: 5px;
    font-size: 16px;
    flex-shrink: 0;
    cursor: pointer;
    transition-property: background-color, scale;
    transition-duration: 0.2s, 0.2s;
}

.dialogue-choice-button:hover {
    background-color: rgb(255, 200, 0);
    color: black;
    scale: 1.05;
}

.dialogue-choice-button:focus {
    background-color: rgb(255, 200, 0);
    color: black;
}
