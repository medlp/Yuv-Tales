.main-container {
    flex-grow: 1;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 50px;
    width: 100%;
    height: 100%;
}

.dialogue-wrapper {
    width: 90%;
    min-width: 1000px;
    align-items: flex-start;
    max-width: 1800px;
}

.actor-name-container {
    background-color: transparent;
    padding: 0px 40px;
    margin-bottom: -25px; /* Overlap with main box border */
    margin-left: 50px;
    align-self: flex-start;
    flex-shrink: 0;
    z-index: 10;
}

.actor-name-label {
    color: rgb(255, 255, 255);
    font-size: 50px;
    -unity-font: url('project://database/Assets/TextMesh Pro/Fonts/YuvTales_v2.ttf');
    -unity-font-definition: initial;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    flex-shrink: 0;
}

.dialogue-content-wrapper {
    flex-direction: row;
    width: 100%;
    align-items: stretch;
}

.dialogue-box {
    background-color: transparent;
    background-image: url('project://database/Assets/Sprites/boite dialogue copie.png');
    -unity-background-scale-mode: stretch-to-fill;
    padding: 60px 80px;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 60%;
    min-height: 350px;
    justify-content: center;
}

.message-text-label {
    color: white;
    font-size: 36px;
    -unity-font: url('project://database/Assets/TextMesh Pro/Fonts/YuvTales_v2.ttf');
    -unity-font-definition: initial;
    white-space: normal;
    -unity-text-align: middle-center;
    flex-shrink: 1;
}

.choices-container {
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    margin-left: 40px;
    flex-shrink: 1;
    min-width: 450px;
    max-width: 40%;
}

.dialogue-choice-button {
    background-color: transparent;
    background-image: url('project://database/Assets/Sprites/selection dialogue .png');
    -unity-background-scale-mode: scale-to-fit;
    color: white;
    border-width: 0px;
    padding: 20px 50px;
    margin-bottom: 20px;
    min-width: 450px;
    min-height: 100px;
    max-width: 600px;
    white-space: normal;
    font-size: 32px;
    -unity-font: url('project://database/Assets/TextMesh Pro/Fonts/YuvTales_v2.ttf');
    -unity-font-definition: initial;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    cursor: pointer;
    transition-property: scale;
    transition-duration: 0.2s;
}

.dialogue-choice-button:hover {
    background-image: url('project://database/Assets/Sprites/selection dialogue on.png');
    scale: 1.05;
}

.dialogue-choice-button:focus {
    background-image: url('project://database/Assets/Sprites/selection dialogue on.png');
}
