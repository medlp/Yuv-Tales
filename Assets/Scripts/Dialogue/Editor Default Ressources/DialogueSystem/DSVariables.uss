:root
{
	--ds-colors-grid-light-grey-1: #2b2b2b;
	--ds-colors-grid-light-grey-2: rgba(51, 51, 51, 0.8);
	--ds-colors-grid-light-grey-3: rgba(51, 51, 51, 1);

	--ds-colors-window-dark-grey-0: #141415;
	--ds-colors-window-dark-grey-1: #1D1D1E;
	--ds-colors-window-dark-grey-2: #2B2D2F;
	--ds-colors-window-dark-grey-3: #212325;
	--ds-colors-window-dark-grey-4: #232527;
	--ds-colors-window-dark-grey-5: #252729;
	--ds-colors-window-dark-grey-6: #27292C;
	--ds-colors-window-yellow: #FDD057;

	--ds-colors-window-dark-black-1: #0F0F10;
	--ds-colors-window-dark-black-2: #111113;

	--ds-metrics-grid-20: 20;
	--ds-metrics-window-pixels-negative-12: -12;
	--ds-metrics-window-pixels-negative-4: -4;
	--ds-metrics-window-pixels-0: 0;
	--ds-metrics-window-pixels-2: 2;
	--ds-metrics-window-pixels-4: 4;
	--ds-metrics-window-pixels-6: 6;
	--ds-metrics-window-pixels-8: 8;
	--ds-metrics-window-pixels-11: 11;
	--ds-metrics-window-pixels-16: 16;
	--ds-metrics-window-pixels-25: 25;
	--ds-metrics-window-pixels-35: 35;
	--ds-metrics-window-pixels-120: 120;
	--ds-metrics-window-pixels-160: 160;
	--ds-metrics-window-pixels-240: 240;
	--ds-metrics-window-pixels-600: 600;
	--ds-metrics-window-pixels-1000: 1000;
}


